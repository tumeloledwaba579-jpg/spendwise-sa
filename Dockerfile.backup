FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install asyncpg from pre-built wheel
COPY requirements.txt .
RUN pip install --no-cache-dir wheel && \
    pip install --no-cache-dir --find-links https://github.com/MagicStack/asyncpg/releases/download/v0.29.0/ \
    asyncpg==0.29.0

RUN pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 10000"]