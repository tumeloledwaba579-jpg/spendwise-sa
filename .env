# Database
DATABASE_URL=postgresql+asyncpg://postgres:root123@postgres:5432/spendwise_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# CORS Origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://frontend:3000,http://localhost:8000

# JWT Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email (Optional - keep them, they'll be ignored)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@spendwise.co.za